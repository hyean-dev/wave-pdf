{
  "name": "Wave PDF",
  "short_name": "Wave PDF",
  "description": "PDF 보기·하이라이트·주석·서명·페이지 편집, 구글 드라이브 연동",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e8ecf0",
  "theme_color": "#0f3b5f",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "icons/file-16.png",
          "sizes": "16x16",
          "type": "image/png"
        },
        {
          "src": "icons/file-32.png",
          "sizes": "32x32",
          "type": "image/png"
        },
        {
          "src": "icons/file-48.png",
          "sizes": "48x48",
          "type": "image/png"
        },
        {
          "src": "icons/file-64.png",
          "sizes": "64x64",
          "type": "image/png"
        },
        {
          "src": "icons/file-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "icons/file-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}