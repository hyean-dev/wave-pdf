{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave PDF",
  "version": "1.0.0",
  "identifier": "io.github.hyeandev.wavepdf",
  "build": { "frontendDist": "../www" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Wave PDF", "width": 1280, "height": 860, "minWidth": 480, "minHeight": 400, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["pdf"], "name": "Wave PDF 문서", "description": "PDF 문서", "mimeType": "application/pdf", "role": "Editor" }],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Korean"], "displayLanguageSelector": false } }
  }
}
